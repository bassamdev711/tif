generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  brand          String?
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  sku            String?
  size           String?
  gender         String?
  category       String?
  collectionId   String?
  collection     Collection? @relation(fields: [collectionId], references: [id])
  stock          Int      @default(0)
  featured       Boolean  @default(false)
  bestseller     Boolean  @default(false)
  isActive       Boolean  @default(true)
  imageUrl       String?
  images         String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  seoSearchPhrases String[]
  seoScore         Int?
  variants         ProductVariant[]
  campaigns        Campaign[]
  viewsCount       Int      @default(0)
  addToCartCount   Int      @default(0)
  salesCount       Int      @default(0)
  reviews          Review[]

  @@index([isActive, featured])
  @@index([isActive, bestseller])
  @@index([isActive, createdAt])
}

model DailyStats {
  id            String   @id @default(cuid())
  date          DateTime @unique
  visitorsCount Int      @default(0)
  pageViews     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String?     @unique
  customerName    String
  customerPhone   String
  governorate     String
  city            String
  address         String
  paymentMethod   String
  paymentStatus   String      @default("PENDING") // PENDING, AWAITING_CONFIRMATION, PAID, FAILED
  status          String      @default("NEW") // NEW, PROCESSING, SHIPPED, COMPLETED, CANCELLED
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 2)
  paymentProofUrl String?
  transactionId   String?
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  idempotencyKey  String?     @unique
  items           OrderItem[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerPhone, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model PaymentSettings {
  id                     String   @id @default("singleton")
  bankTransferEnabled    Boolean  @default(true)
  bankTransferInstructions String?
  walletsEnabled         Boolean  @default(true)
  walletsInstructions    String?
  codEnabled             Boolean  @default(false)
  codFee                 Decimal  @db.Decimal(10, 2) @default(0)
  codInstructions        String?
  currency               String   @default("ر.ي")
  updatedAt              DateTime @updatedAt
}

model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DigitalWallet {
  id            String   @id @default(cuid())
  walletName    String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  seoSearchPhrases String[]
}

model StoreSettings {
  id                    String   @id @default("singleton")
  shippingFee           Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(0) @db.Decimal(10, 2)
  storeName             String?
  storeDescription      String?
  seoSearchPhrases      String[]
  showShippingInFooter  Boolean  @default(false)
  showReturnInFooter    Boolean  @default(false)
  shippingPolicyContent String?  @db.Text
  returnPolicyContent   String?  @db.Text
  ogImageUrl            String?  // صورة المشاركة (Open Graph)
  faviconUrl            String?  // أيقونة المتصفح (Favicon)
  storeUrl              String?  // رابط المتجر لتوليد QR Code
  updatedAt             DateTime @updatedAt
}

model LegalPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  isActive    Boolean  @default(true)
  seoTopic    String?
  seoSearchPhrases String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── نظام التسويق ───────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique          // كود الكوبون (مثل: SUMMER20)
  description    String?                   // وصف اختياري للمدير
  type           String                    // PERCENTAGE | FIXED
  value          Decimal   @db.Decimal(10, 2) // قيمة الخصم
  minOrderAmount Decimal?  @db.Decimal(10, 2) // حد أدنى للطلب
  maxUses        Int?                      // حد أقصى للاستخدام (null = غير محدود)
  usedCount      Int       @default(0)    // عدد مرات الاستخدام الفعلية
  expiresAt      DateTime?               // تاريخ الانتهاء (null = لا ينتهي)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
}

model Campaign {
  id                 String    @id @default(cuid())
  slug               String?   @unique                  // رابط خاص بالحملة
  title              String                             // عنوان الحملة
  description        String?                            // وصف/رسالة الحملة
  imageUrl           String?                            // صورة البانر (اختيارية)
  couponCode         String?                            // كود كوبون مرتبط بالحملة
  discountPercentage Int?                               // نسبة الخصم التلقائية المطبقة
  startDate          DateTime                           // تاريخ البداية
  endDate            DateTime                           // تاريخ الانتهاء
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  products           Product[]                          // المنتجات المرتبطة بالحملة
}

model AnnouncementBar {
  id        String   @id @default("singleton")
  message   String                           // نص الإعلان
  linkText  String?                          // نص الرابط (اختياري)
  linkUrl   String?                          // الرابط (اختياري)
  bgColor   String   @default("#1a544a")    // لون الخلفية
  textColor String   @default("#ffffff")     // لون النص
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ContactSettings {
  id              String   @id @default("singleton")
  
  phoneNumber     String?
  showPhoneNumber Boolean  @default(true)
  
  whatsappNumber  String?
  showWhatsappNumber Boolean @default(true)
  
  emailAddress    String?
  showEmailAddress Boolean @default(true)
  
  address         String?
  showAddress     Boolean  @default(true)
  
  instagramUrl    String?
  showInstagram   Boolean  @default(true)
  
  facebookUrl     String?
  showFacebook    Boolean  @default(true)
  
  twitterUrl      String?
  showTwitter     Boolean  @default(true)

  telegramUrl     String?
  showTelegram    Boolean  @default(true)

  threadsUrl      String?
  showThreads     Boolean  @default(true)
  
  updatedAt       DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ShippingCity {
  id          String   @id @default(cuid())
  name        String   @unique
  shippingFee Decimal  @db.Decimal(10, 2) @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  city      String?
  content   String
  rating    Int      @default(5)
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  isGlobal  Boolean  @default(true)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSettings {
  id                  String   @id @default("singleton")
  // Hero Section
  heroTitle           String   @default("طيف")
  heroSubtitle        String   @default("حضورٌ لا يُنسى.")
  heroDescription     String   @default("اكتشف مجموعتنا الحصرية من العطور الفاخرة، المصممة بعناية فائقة لتمنحك تجربة حسية فريدة تدوم طويلاً.")
  heroPrimaryButton   String   @default("اكتشف المجموعة")
  heroSecondaryButton String   @default("قصة طيف")

  // About Section
  aboutTopTitle       String   @default("فلسفة طيف")
  aboutMainTitle      String   @default("من نحن")
  aboutQuote          String   @default("\"في تقاطع النقاء والفخامة، وُلدت طيف. لتكون أكثر من مجرد علامة تجارية، بل حالة من التسامي والندرة.\"")
  aboutDescription    String   @default("حرفية استثنائية، إلهام كلاسيكي، وتكريس لأغلى المكونات العطرية. نحن نعيد تعريف الفخامة برؤية عصرية وهدوء لا مثيل له.")

  // Experience Section
  expTopTitle         String   @default("The Philosophy of Light")
  expMainTitle        String   @default("تجربة طيف")
  expBox1Title        String   @default("الضوء والبلور")
  expBox1Desc         String   @default("نحن لا نصنع عطوراً فحسب، بل نلتقط الضوء في زجاجات كريستالية. كل قطرة تعكس نقاء الروح وتضيء العتمة، لتخلق هالة من السحر حول من يرتديها.")
  expBox2Title        String   @default("الصفاء المطلق")
  expBox2Desc         String   @default("مكوناتنا مستخلصة من أندر زهور الأرض، ممتزجة مع نسمات الهواء الباردة وقطرات الندى، لتعطي إحساساً بالبرودة والانتعاش الفاخر.")

  // Stats Section (Stored as JSON array to allow flexible stats)
  statsJson           String   @default("[{\"value\":\"10K+\",\"label\":\"عميل يثق بنا\"},{\"value\":\"50+\",\"label\":\"مكون عطري نادر\"},{\"value\":\"100%\",\"label\":\"زيوت عطرية نقية\"},{\"value\":\"24h\",\"label\":\"ثبات العطر\"}]")

  updatedAt           DateTime @updatedAt
}

model AdminProfile {
  id              String   @id @default("singleton")
  name            String   @default("مدير المتجر")
  avatarUrl       String?
  themeBackground String?
  passwordHash    String?
  isSetupComplete Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AdminSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

